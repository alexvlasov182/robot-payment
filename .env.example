
# PostgreSQL
POSTGRES_USER=robot_user
POSTGRES_PASSWORD=robot_pass
POSTGRES_DB=robot_payment

# Database (local)
DATABASE_URL=postgresql://robot_user:robot_pass@db:5432/robot_payment
LOCAL_DATABASE_URL=postgresql://robot_user:robot_pass@db:5432/robot_payment

# Security
SECRET_KEY=dev-secret-key-change-in-production
APP_ENV=development
DEBUG=True

# AWS (leave empty for local development)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
MAX_UPLOAD_SIZE_MB=10
